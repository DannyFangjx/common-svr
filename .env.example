APP_ENV=dev
SERVICE_NAME=common-svr
HTTP_ADDR=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info

# Optional OTLP gRPC endpoint, for example localhost:4317.
# Empty means traces are not exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_ARG=1.0

# Dedicated local Docker PostgreSQL managed by compose.yaml.
COMMON_PG_PORT=55433
COMMON_PG_USER=common_server
COMMON_PG_PASSWORD=
COMMON_PG_DATABASE=common_server_db

DATABASE_DRIVER=postgres
DATABASE_MAX_OPEN_CONNECTIONS=20
DATABASE_MAX_IDLE_CONNECTIONS=5
DATABASE_CONNECTION_MAX_LIFETIME=30m
DATABASE_AUTO_MIGRATE=true
DATABASE_DSN=host=127.0.0.1 port=${COMMON_PG_PORT} user=${COMMON_PG_USER} password=${COMMON_PG_PASSWORD} dbname=${COMMON_PG_DATABASE} sslmode=disable TimeZone=Asia/Shanghai

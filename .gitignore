# Local environment and secrets
.env
.env.*
!.env.example

# Private key material under config/; public .crt files may be committed.
config/**/*.key
config/**/*.p12
config/**/*.pfx

# Runtime output
logs/*
!logs/.gitkeep
output/
bin/
*.log

# Test and coverage output
coverage.out
*.test

# Dependencies
vendor/

# IDE and OS files
.idea/
.vscode/
.DS_Store
